# Copy to .env.local and fill in real values. Never commit .env.local.

# Supabase — mobiletechjoint project
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Paystack
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Instagram Graph API (Workstream B)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin panel (draft-product review/publish) — legacy shared-password
# fallback, kept alongside the staff RBAC system below.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Staff portal (/staff/*) — signs the staff session cookie. Falls back to
# ADMIN_SESSION_SECRET if unset, but set a real independent value.
STAFF_SESSION_SECRET=

# Cron protection for the Instagram sync route
CRON_SECRET=

# Footer contact info — each row only renders if set (see SiteFooter.tsx).
# Never fill these with placeholder/guessed values.
SUPPORT_EMAIL=
SUPPORT_PHONE=
INSTAGRAM_URL=
